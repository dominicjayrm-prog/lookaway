# Copy this file to `.env` and fill in the values. `.env` is
# gitignored — your keys stay on your machine.
#
# For TestFlight / production builds, also add these to
# eas.json under the build profile's `env` block so EAS picks
# them up in the cloud.

# PostHog product analytics. Get the project API key from
# https://app.posthog.com (starts with "phc_"). Leave blank to
# disable analytics entirely — the app no-ops gracefully.
EXPO_PUBLIC_POSTHOG_API_KEY=

# Override the PostHog host if using US Cloud (default is EU).
# Options:
#   EU:           https://eu.i.posthog.com  (default)
#   US:           https://us.i.posthog.com
#   Self-hosted:  https://your-posthog-domain
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
