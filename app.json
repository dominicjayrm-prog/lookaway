{
  "expo": {
    "name": "Blanked",
    "slug": "blanked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "blanked",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C5CE7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blanked.app",
      "buildNumber": "18",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:playblanked.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a friend's QR code to add them to your friends list instantly.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a friend's QR code to add them to your friends list instantly."
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-9228812020612351~2660968331",
          "userTrackingUsageDescription": "This identifier will be used to show you personalised ads."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to show you personalised ads."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
