{
  "expo": {
    "name": "Blanked",
    "slug": "blanked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "blanked",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blanked.app",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:blanked.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a friend's QR code to add them to your friends list instantly."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.blanked.app",
      "permissions": ["android.permission.CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "https", "host": "blanked.app", "pathPrefix": "/invite" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a friend's QR code to add them to your friends list instantly."
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
